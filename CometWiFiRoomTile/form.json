{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "📖  Dokumentation & Hilfe",
            "expanded": false,
            "items": [
                {
                    "type": "Label",
                    "caption": "Diese Kachel zeigt EIN Thermostat groß und bedienbar. Für die Übersicht aller Geräte gibt es die „Comet WiFi Kachel“ — beide lassen sich nebeneinander verwenden."
                },
                {
                    "type": "Label",
                    "caption": "Der Ring ist die Bedienfläche: Ein Tipp darauf setzt den Sollwert, die Knöpfe darunter stellen in Halbgrad-Schritten nach."
                },
                {
                    "type": "Label",
                    "caption": "Gesteuert wird über die Geräteinstanz, nicht an ihr vorbei. Damit gilt auch von hier aus die dort eingestellte Umschaltung auf Handbetrieb — ohne sie überschreibt das Wochenprogramm im Gerät den Sollwert beim nächsten Schaltpunkt."
                },
                {
                    "type": "Label",
                    "caption": "„Aus“ und „An“ sind die Endanschläge des Ventils (ganz zu bzw. ganz auf) und werden benannt statt als Temperatur angezeigt."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🌡️  Thermostat",
            "expanded": true,
            "items": [
                {
                    "type": "SelectInstance",
                    "name": "DeviceID",
                    "caption": "Gerät",
                    "validModules": [
                        "{0F552C16-D685-4C9F-86C0-8D89E4BFD158}"
                    ],
                    "width": "420px"
                },
                {
                    "type": "Label",
                    "name": "DeviceLabel",
                    "caption": " "
                },
                {
                    "type": "ValidationTextBox",
                    "name": "RoomName",
                    "caption": "Abweichender Name",
                    "width": "420px"
                },
                {
                    "type": "Label",
                    "caption": "Leer lassen, dann steht der Name der Geräteinstanz in der Kachel."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "🎚️  Bedienung und Anzeige",
            "expanded": true,
            "items": [
                {
                    "type": "CheckBox",
                    "name": "AllowControl",
                    "caption": "Bedienbar (Ring, Knöpfe, Betriebsart)"
                },
                {
                    "type": "CheckBox",
                    "name": "ShowDetails",
                    "caption": "Fußzeile mit Batterie, Signal und letzter Meldung"
                },
                {
                    "type": "NumberSpinner",
                    "name": "BatteryWarnBelow",
                    "caption": "Batterie hervorheben unter … %",
                    "suffix": "%",
                    "minimum": 0,
                    "maximum": 100,
                    "width": "240px"
                },
                {
                    "type": "NumberSpinner",
                    "name": "ClockWarnMinutes",
                    "caption": "Geräteuhr melden ab Abweichung",
                    "suffix": "min",
                    "minimum": 0,
                    "maximum": 720,
                    "width": "240px"
                },
                {
                    "type": "Label",
                    "caption": "Das Wochenprogramm läuft im Thermostat. Geht dessen Uhr falsch, verschiebt sich jeder Schaltpunkt um dieselbe Spanne. 0 schaltet den Hinweis ab."
                }
            ]
        }
    ],
    "actions": [
        {
            "type": "Button",
            "caption": "🔄  Jetzt aktualisieren",
            "onClick": "CWIFIR_RequestUpdate($id);"
        }
    ],
    "status": [
        {
            "code": 201,
            "icon": "inactive",
            "caption": "Kein Thermostat ausgewählt – die Kachel bleibt leer, bis eines zugeordnet ist."
        }
    ]
}
